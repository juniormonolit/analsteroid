+/** Дообновление (владелец 23.10: «платить только за свежие звонки»): прошлый отчёт + только новые звонки,
+ *  модель переписывает отчёт целиком. Полный разбор — если прошлый отчёт другой версии промпта, старше
+ *  INCREMENTAL_MAX_DAYS или новых звонков больше INCREMENTAL_MAX_SHARE (тогда экономии почти нет, а ошибки копятся). */
+export const INCREMENTAL_MAX_DAYS = 90;
+const INCREMENTAL_MAX_SHARE = 0.6;
+export function planIncremental(data: ClientCallData, prev: PreviousReport | null, promptVersion: string): { prev: PreviousReport; newCalls: CollectedCall[] } | null {
+  if (!prev || prev.promptVersion !== promptVersion) return null;
+  if (Date.now() - new Date(prev.createdAt).getTime() > INCREMENTAL_MAX_DAYS * 86_400_000) return null;
+  // Прочитанные звонки — по списку id (с этой версии); у старых отчётов его нет — по дате отчёта.
+  const seen = prev.callIds ? new Set(prev.callIds) : null;
+  const newCalls = data.calls.filter(c => (seen ? !seen.has(c.id) : c.calledAt > prev.createdAt));
+  if (!newCalls.length || newCalls.length > data.calls.length * INCREMENTAL_MAX_SHARE) return null;
+  return { prev, newCalls };
+}
 
